<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page - Short URL</title>
</head>
<style>
    body {
        font-family: sans-serif;
    }

    h1 {
        text-align: center;
    }

    form {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;

        input {
            width: 300px;
            padding: 5px 12px;
            border-radius: 24px;
            border: 2px solid gray;
            outline: none;
            transition: all .3s ease-in-out;
        }

        input:focus {
            transition: all .3s ease-in-out;
            border: 2px solid black;
        }

        button {
            width: 120px;
            height: 30px;
            border: 2px solid gray;
            background-color: transparent;
            color: black;
            border-radius: 24px;
            transition: all .3s ease-in-out;
            cursor: pointer;
            outline: none;
        }

        button:hover {
            transition: all .3s ease-in-out;
            background-color: black;
            color: white;
            border: 2px solid black;
            box-shadow: inset 0px 5px 10px gray, inset 0px -5px 5px rgb(41, 41, 41);
        }
    }

    .table {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 50vh;
    }

    table {
        /* border: 1px solid gray; */
        padding: 4px 10px;
        text-align: center;
    }

    th {
        border-bottom: 1px solid gray;
    }

    td {
        border-bottom: 1px solid gray;
        padding: 0px 20px;
    }
</style>

<body>
    <h1>URL Shortener</h1>
    <form action="/url" method="post">
        <input type="text" name="url" placeholder="https://example.com">
        <button type="submit">Generate</button>
    </form>
    <% if (locals.id) { %>
        <p>Generated Short URL: [ http://localhost:8080/<%= id %> ]</p>
        <a href="http://localhost:8080">Back to MAIN</a>
        <% } %>
            <div class="table">
                <% if (locals.urls && urls.length> 0) { %>
                    <table>
                        <tr>
                            <th>S.no</th>
                            <th>Short ID</th>
                            <th>Redirect URL</th>
                            <th>Clicks</th>
                            <th>Short URL</th>
                        </tr>

                        <% urls.forEach((url, index)=> { %>
                            <tr>
                                <td>
                                    <%= index + 1 %>
                                </td>
                                <td>
                                    <%= url.shortId %>
                                </td>
                                <td>
                                    <%= url.redirectURL %>
                                </td>
                                <td>
                                    <%= url.visitHistory.length %>
                                </td>
                                <td>
                                    http://localhost:8080/<%= url.shortId %>
                                </td>
                            </tr>
                            <% }) %>
                    </table>
                    <% } %>
            </div>
</body>

</html>