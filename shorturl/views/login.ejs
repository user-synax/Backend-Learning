<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>
<style>
    body {
        font-family: sans-serif;
    }
    *{
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body{
        background-color: rgb(224, 224, 224);
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        flex-direction: column;
    }
    .loginArea{
        display: flex;  
        flex-direction: column;
        width: 35vw;
        height: 35vh;

        h1{
            text-align: center;
            margin: 20px 10px;
            font-size: 40px;
        }

        form{
            margin: 10px;
            display: flex;
            justify-content: center;
            align-items: start;
            flex-direction: column;

            label{
                font-size: 18px;
                margin: 10px 0px;
                color: gray;
            }

            input{
                width: 100%;
                height: 35px;
                padding: 14px 12px;
                outline: none;
                border: 2px solid gray;
                transition: all .3s ease;
            }

            input:focus{
                transition: all .3s ease;
                border: 2px solid #63e;
            }

            button{
                margin-top: 20px;
                width: 100%;
                height: 30px;
                border: 2px solid #63e;
                background-color: transparent;
                color: black;
                transition: all .3s ease;
            }

            button:hover{
                transition: all .3s ease;
                background-color: #63e;
                color: white;
                cursor: pointer;
            }
        }
    }

    .msg{
        display: flex;
        background-color: rgba(206, 79, 79, 0.404);
        color: red;
        padding: 8px 24px;
        margin-top: 10vh;
    }
</style>

<body>
    <div class="loginArea">
    <h1>Login</h1>
    <form action="/user/login" method="post">
        <label>Email</label>
        <input type="text" name="email" placeholder="Enter Your Email Address">
        <label>Password</label>
        <input type="text" name="password" placeholder="Enter Your Password">
        <button type="submit">Login</button>
    </form>
    </div>
    <div class="msg">
        <% if (locals.msg) { %>
            <p>
                <%= msg %>
            </p>
        <% } %>
    </div>
</body>

</html>